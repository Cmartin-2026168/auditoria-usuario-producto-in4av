<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="raiz" spacing="14" stylesheets="@../resources/styles/AuditoriaStyles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.camilomartin.system.controller.AuditoriaController">
   <padding>
      <Insets bottom="18" left="18" right="18" top="18" />
   </padding>
   <children>
      <Label styleClass="titulo-vista" text="Auditoría" />

      <TableView fx:id="tablaAuditoria" prefHeight="350.0" styleClass="tabla">
         <columns>
            <TableColumn fx:id="colUsuario" prefWidth="100.0" text="Usuario" />
            <TableColumn fx:id="colAccion" prefWidth="140.0" text="Acción" />
            <TableColumn fx:id="colEntidad" prefWidth="100.0" text="Entidad" />
            <TableColumn fx:id="colDetalle" prefWidth="220.0" text="Detalle" />
            <TableColumn fx:id="colFecha" prefWidth="150.0" text="Fecha" />
         </columns>
      </TableView>

      <Button fx:id="btnVolver" onAction="#handleVolver" styleClass="boton-secundario" text="Volver al Menú" />
   </children>
</VBox>
